# Remains off until the approved owner's intake system meets the documented contract.
# Server-only. Never use NEXT_PUBLIC_ for the URL or credential.
AS_INTAKE_ENABLED=false
AS_INTAKE_WEBHOOK_URL=
AS_INTAKE_WEBHOOK_TOKEN=

# Review-only CRM. Do not enable until docs/as-crm-mvp.md acceptance checks pass.
# All values are server-only; no NEXT_PUBLIC_ credentials. Use a dedicated A&S project.
AS_CRM_ENABLED=false
AS_CRM_DATABASE_URL=
AS_CRM_SERVICE_KEY=
AS_CRM_SITE_ORIGIN=
# Distinct scoped intake credential. Set AS_INTAKE_WEBHOOK_TOKEN to the same approved value.
AS_CRM_INTAKE_TOKEN=
